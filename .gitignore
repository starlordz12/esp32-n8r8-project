# ---------------------------------------------------------------------------
# Secrets and credentials -- never commit these.
# Commit a *.example template with placeholder values instead.
# ---------------------------------------------------------------------------
secrets.h
secrets.hpp
credentials.h
credentials.hpp
wifi_credentials.h
*secret*.h
*secret*.json
*credentials*.json
*.pem
*.key
*.p12
*.pfx
*.crt
!*.example
!*.example.*

# ---------------------------------------------------------------------------
# Local environment / machine-specific config (serial ports, upload settings)
# ---------------------------------------------------------------------------
.env
.env.*
!deploy/pi/.env.example
*.local
*.local.*
platformio_local.ini
local.ini
local.cfg
upload_port.txt

# ---------------------------------------------------------------------------
# PlatformIO
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

