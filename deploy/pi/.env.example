# Copy to .env and replace this placeholder with: openssl rand -hex 32
RUVIEW_API_TOKEN=replace-with-a-random-64-character-hex-token

# Safe defaults: only the dashboard and ESP32 UDP ingest are LAN-accessible.
DASHBOARD_BIND_ADDRESS=0.0.0.0
RUVIEW_HTTP_BIND_ADDRESS=127.0.0.1
RUVIEW_WS_BIND_ADDRESS=127.0.0.1
RUVIEW_UDP_BIND_ADDRESS=0.0.0.0
RUVIEW_LOG_LEVEL=info
